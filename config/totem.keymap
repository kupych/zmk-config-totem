//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define GAME 4
#define REAPER 5

// WMOD = Cmd+Ctrl+Alt held as one chord -- the macOS window-manager (AeroSpace)
// modifier. Shift is deliberately left OUT so WMOD+Shift stays a *distinct*
// combo: WMOD+n switches desktop, WMOD+Shift+n moves a window there -- the same
// super / super+shift split used on Hyprland. Cmd+Ctrl+Alt+<key> is effectively
// unused by macOS apps, unlike GUI/Cmd+number and Cmd+arrows which collide
// everywhere. Lives on the left outer pinky (base pos 20; &trans on
// NAV/SYM/ADJ so it falls through). LC/LA wrap the LGUI keycode -> Cmd+Ctrl+Alt
// all register while held. On Linux this reads as Super+Ctrl+Alt: free, and
// clear of the Ctrl+Alt+F# TTY-switch chords.
#define WMOD LC(LA(LGUI))

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    behaviors {
        // Layer-taps that also hold a "sentinel" key while the layer is active,
        // so the live keymap HUD (watching evdev) can follow the layer. Tap is
        // TAB/ESC exactly as before; hold = momentary layer + F16/F17.
        // Sentinel choice is fussy because it must be inert everywhere this
        // board roams: F13-F15 dim the display on macOS and LANG1-3 toggle the
        // IME under fcitx/mozc on Linux. F16-F18 have no default action on
        // either OS; their only downside is terminals encode them, which we
        // swallow host-side (ghostty: keybind = f16/f17/f18 = ignore) so they
        // don't leak into vim's insert mode. Matches the built-in &lt feel
        // (tap-preferred, 200ms) so typing is unchanged.
        lt_nav: layer_tap_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo_f16>, <&kp>;
        };
        lt_sym: layer_tap_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo_f17>, <&kp>;
        };
    };

    macros {
        // Hold &mo <layer> together with the layer's sentinel key until release.
        // mo_f16/mo_f17 take the layer number as a parameter (for the hold-taps
        // above); adj_f18 is fixed to layer 3 (ADJ has no tap action). See the
        // lt_nav note for why F16-F18; the HUD daemon maps F16->NAV, F17->SYM,
        // F18->ADJ.
        mo_f16: mo_f16 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_param_1to1>,
                       <&macro_press &mo MACRO_PLACEHOLDER &kp F16>,
                       <&macro_pause_for_release>,
                       <&macro_param_1to1>,
                       <&macro_release &mo MACRO_PLACEHOLDER &kp F16>;
        };
        mo_f17: mo_f17 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_param_1to1>,
                       <&macro_press &mo MACRO_PLACEHOLDER &kp F17>,
                       <&macro_pause_for_release>,
                       <&macro_param_1to1>,
                       <&macro_release &mo MACRO_PLACEHOLDER &kp F17>;
        };
        adj_f18: adj_f18 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mo 3 &kp F18>,
                       <&macro_pause_for_release>,
                       <&macro_release &mo 3 &kp F18>;
        };

        // Multi-character coding operators, fired from base-layer combos so they
        // don't need the SYM layer. Default 0ms macro timing is fine for &kp.
        pipe_arrow: pipe_arrow {   // |>  (Elixir pipe)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PIPE &kp GT>;
        };
        thin_arrow: thin_arrow {   // ->  (Elixir/Go)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };
        fat_arrow: fat_arrow {     // =>  (Elixir maps)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };
        walrus: walrus {           // :=  (Go)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp EQUAL>;
        };

        // Toggle the REAPER app layer AND signal the keymap HUD: &tog flips the
        // layer, &kp F20 taps the HUD's sticky sentinel (see hud.yaml's
        // sticky_sentinels: F20 -> 5). Pressing again toggles both back off in
        // lockstep. F20 is inert on Linux/macOS like F16-F19; swallow it in your
        // terminal too (ghostty: keybind = f20=ignore).
        reaper_tog: reaper_tog {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog REAPER>, <&kp F20>;
        };

        // Same idea for GAME: toggle the layer and tap F21 so the HUD follows
        // it. F21 is inert on Linux but has no macOS virtual keycode, so this
        // sticky layer is Linux-only (fine — no gaming on the Mac).
        game_tog: game_tog {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog GAME>, <&kp F21>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Mouse-click combos sit on adjacent top-row keys, which double as
        // gaming keys (W/E/R etc.), so they're scoped to everything *except*
        // GAME to avoid firing clicks mid-game.
        combo_lclk_l {
            timeout-ms = <20>;
            key-positions = <2 3>;
            bindings = <&mkp MB1>;
            layers = <BASE NAV SYM ADJ>;
        };

        combo_lclk_r {
            timeout-ms = <20>;
            key-positions = <6 7>;
            bindings = <&mkp MB1>;
            layers = <BASE NAV SYM ADJ>;
        };

        combo_rclk_l {
            timeout-ms = <20>;
            key-positions = <1 0>;
            bindings = <&mkp MB2>;
            layers = <BASE NAV SYM ADJ>;
        };

        combo_rclk_r {
            timeout-ms = <20>;
            key-positions = <8 9>;
            bindings = <&mkp MB2>;
            layers = <BASE NAV SYM ADJ>;
        };

        combo_mclk_l {
            bindings = <&mkp MB3>;
            key-positions = <2 1>;
            timeout-ms = <20>;
            layers = <BASE NAV SYM ADJ>;
        };

        combo_mclk_r {
            bindings = <&mkp MB3>;
            key-positions = <7 8>;
            timeout-ms = <20>;
            layers = <BASE NAV SYM ADJ>;
        };

        // Coding-operator combos, base layer only. Rare-letter key pairs keep
        // misfires near zero during normal typing.
        combo_pipe_arrow {   // K + H  ->  |>
            timeout-ms = <28>;
            key-positions = <26 27>;
            bindings = <&pipe_arrow>;
            layers = <0>;
        };
        combo_thin_arrow {   // , + .  ->  ->
            timeout-ms = <28>;
            key-positions = <28 29>;
            bindings = <&thin_arrow>;
            layers = <0>;
        };
        combo_walrus {       // C + D  ->  :=
            timeout-ms = <28>;
            key-positions = <23 24>;
            bindings = <&walrus>;
            layers = <0>;
        };
        combo_fat_arrow {    // Z + X  ->  =>
            timeout-ms = <28>;
            key-positions = <21 22>;
            bindings = <&fat_arrow>;
            layers = <0>;
        };

        // Both outer pinkies (bottom row, opposite halves) -> toggle keymap HUD.
        // Sends F19: an inert key on Linux and macOS that the host HUD listens
        // for (ghostty swallows it like the layer sentinels). No `layers`
        // restriction so it works from any layer; wide timeout since it's a
        // deliberate two-handed chord, not a roll.
        combo_hud {          // pos 20 + 31  ->  F19 (HUD toggle)
            timeout-ms = <50>;
            key-positions = <20 31>;
            bindings = <&kp F19>;
        };

        // Both top outer corners (Q + ;) -> toggle the GAME layer on/off.
        // A deliberate two-handed chord so it never misfires during one-handed
        // gaming, yet still reaches you to switch back off. No `layers`
        // restriction so it works from any layer, including GAME itself.
        combo_game {         // pos 0 + 9  ->  toggle GAME layer
            timeout-ms = <50>;
            key-positions = <0 9>;
            bindings = <&game_tog>;
        };

        // Both inner top keys (B + J) -> toggle the REAPER app layer (and tell
        // the HUD via reaper_tog). Two-handed and on rare-adjacent letters, so
        // it won't misfire while typing. No `layers` restriction, so the same
        // chord both enters REAPER and exits it.
        combo_reaper {       // pos 4 + 5  ->  toggle REAPER layer
            timeout-ms = <45>;
            key-positions = <4 5>;
            bindings = <&reaper_tog>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            display-name = "BASE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     F     ┃     P     ┃     B     ┃   ┃     J     ┃     L     ┃     U     ┃     Y     ┃     ;     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     A     ┃     R     ┃     S     ┃     T     ┃     G     ┃   ┃     M     ┃     N     ┃     E     ┃     I     ┃     O     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃     Q     ┃     Z     ┃     X     ┃     C     ┃     D     ┃     V     ┃   ┃     K     ┃     H     ┃     ,     ┃     .     ┃     /     ┃     \     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃    TAB    ┃    SPC    ┃   ┃   ENTER   ┃           ┃   BSPC    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
              &kp Q       &kp W       &kp F        &kp P        &kp B        &kp J    &kp L        &kp U        &kp Y       &kp SEMI
              &mt LGUI A  &mt LALT R  &mt LCTRL S  &mt LSHFT T  &kp G        &kp M    &mt RSHFT N  &mt RCTRL E  &mt RALT I  &mt RGUI O
&kp WMOD      &kp Z       &kp X       &kp C        &kp D        &kp V        &kp K    &kp H        &kp COMMA    &kp DOT     &kp FSLH    &kp BSLH
                                      &kp DEL      &lt_nav 1 TAB  &kp SPACE  &kp RET  &lt_sym 2 ESC  &kp BSPC
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        nav_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            display-name = "NAVI";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃    ESC    ┃    CLCK   ┃     UP    ┃   SUPER   ┃     {     ┃   ┃     }     ┃     7     ┃     8     ┃     9     ┃     +     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   SHIFT   ┃   LEFT    ┃    DOWN   ┃   RIGHT   ┃     [     ┃   ┃     ]     ┃     4     ┃     5     ┃     6     ┃     -     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃    DEL    ┃    P UP   ┃   CWORD   ┃    P DN   ┃     (     ┃   ┃     )     ┃     1     ┃     2     ┃     3     ┃     *     ┃     _     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃    TAB    ┃    SPC    ┃   ┃    ADJ    ┃     0     ┃    BSPC   ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
        &kp ESC    &sk CLCK   &kp UP      &kp LGUI   &kp LBRC    &kp RBRC  &kp N7     &kp N8     &kp N9     &kp KP_PLUS
        &kp LSHFT  &kp LEFT   &kp DOWN    &kp RIGHT  &kp LBKT    &kp RBKT  &kp N4     &kp N5     &kp N6     &kp KP_MINUS
&trans  &kp DEL    &kp PG_UP  &caps_word  &kp PG_DN  &kp LPAR    &kp RPAR  &kp N1     &kp N2     &kp N3     &kp KP_MULTIPLY  &kp UNDER
                              &trans      &trans     &trans      &adj_f18  &kp N0     &trans
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        sim_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            display-name = "SYM";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     !     ┃     @     ┃     #     ┃     $     ┃     %     ┃   ┃     ˆ     ┃     &     ┃     *     ┃     ?     ┃     '     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     +     ┃     =     ┃     (     ┃     )     ┃     "     ┃   ┃     :     ┃     ]     ┃     [     ┃     }     ┃     {     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃     <     ┃     |     ┃     -     ┃     >     ┃     \     ┃   ┃     `     ┃     _     ┃     /     ┃     ~     ┃     ;     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃    TAB    ┃    ADJ    ┃   ┃    RET    ┃    PLAY   ┃    BSPC   ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
        &kp EXCL  &kp AT     &kp HASH   &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR   &kp QMARK  &kp SQT
        &kp PLUS  &kp EQUAL  &kp LPAR   &kp RPAR  &kp DQT      &kp COLON  &kp RBKT   &kp LBKT   &kp RBRC   &kp LBRC
&trans  &kp LT    &kp PIPE   &kp MINUS  &kp GT    &kp BSLH     &kp GRAVE  &kp UNDER  &kp SLASH  &kp TILDE  &kp SEMI  &trans
                             &trans     &trans    &adj_f18     &trans     &kp C_PP   &trans
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        adjust_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            display-name = "ADJ";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃   RESET   ┃ BT CLEAR  ┃  OUT TOG  ┃   SEL 0   ┃   SEL 1   ┃   ┃           ┃    F7     ┃    F8     ┃    F9     ┃    F12    ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃ BOOTLOAD  ┃ BT NEXT   ┃  CLR ALL  ┃   SEL 2   ┃   SEL 3   ┃   ┃           ┃    F4     ┃    F5     ┃    F6     ┃    F11    ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃ BT PREV   ┃   SEL 4   ┃           ┃           ┃   ┃           ┃    F1     ┃    F2     ┃    F3     ┃    F10    ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃           ┃           ┃   ┃           ┃           ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
        &sys_reset   &bt BT_CLR  &out OUT_TOG    &bt BT_SEL 0  &bt BT_SEL 1    &trans  &kp F7  &kp F8  &kp F9  &kp F12
        &bootloader  &bt BT_NXT  &bt BT_CLR_ALL  &bt BT_SEL 2  &bt BT_SEL 3    &trans  &kp F4  &kp F5  &kp F6  &kp F11
&trans  &trans       &bt BT_PRV  &bt BT_SEL 4    &trans        &trans          &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans
                                 &trans        &trans  &trans    &trans  &trans  &trans
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        game_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            display-name = "GAME";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            // Left half = QWERTY WASD (plain keys, no home-row mods), shifted one
            // column right to suit the stagger so the pinky gets its own column;
            // T/G/B move to that freed pinky column since the index side has no
            // room. Right half = numpad (7-8-9 / 4-5-6 / 1-2-3 in the middle
            // columns, like NAV) plus menu/chat keys and GRV for the dev console.
            // Toggle on/off with the Q + ; corner combo or the &tog key.
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     T     ┃     Q     ┃     W     ┃     E     ┃     R     ┃   ┃     `     ┃     7     ┃     8     ┃     9     ┃     -     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     G     ┃     A     ┃     S     ┃     D     ┃     F     ┃   ┃    TAB    ┃     4     ┃     5     ┃     6     ┃     .     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃    TAB    ┃     B     ┃     Z     ┃     X     ┃     C     ┃     V     ┃   ┃    ESC    ┃     1     ┃     2     ┃     3     ┃     0     ┃   GAME    ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃   CTRL    ┃   SHIFT   ┃    SPC    ┃   ┃   ENTER   ┃   BSPC    ┃    DEL    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
              &kp T       &kp Q       &kp W        &kp E        &kp R        &kp GRAVE  &kp N7     &kp N8     &kp N9      &kp MINUS
              &kp G       &kp A       &kp S        &kp D        &kp F        &kp TAB    &kp N4     &kp N5     &kp N6      &kp DOT
&kp TAB       &kp B       &kp Z       &kp X        &kp C        &kp V        &kp ESC    &kp N1     &kp N2     &kp N3      &kp N0     &game_tog
                                      &kp LCTRL    &kp LSHFT    &kp SPACE    &kp RET    &kp BSPC   &kp DEL
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        reaper_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            display-name = "REAPR";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            // A starter REAPER layer. Reach/leave it with the B+J combo
            // (combo_reaper). The left hand carries OS-standard edit chords that
            // Reaper honours no matter your config (Save/Undo/Redo/Cut/Copy/
            // Paste); the right hand + thumbs carry Reaper transport/edit
            // actions. The latter use Reaper *defaults* — verify or rebind them
            // in Reaper's Actions list (Actions > Show action list) to taste.
            // Everything else is &trans (falls through to BASE). Tune freely.
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃           ┃           ┃           ┃           ┃           ┃   ┃           ┃           ┃           ┃           ┃           ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   SAVE    ┃   REDO    ┃   UNDO    ┃   SPLIT   ┃           ┃   ┃   MARK    ┃           ┃           ┃           ┃           ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃    CUT    ┃   COPY    ┃           ┃   PASTE   ┃   ┃           ┃           ┃           ┃           ┃           ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃           ┃   PLAY    ┃   ┃    REC    ┃    ESC    ┃   BSPC    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
              &trans      &trans       &trans       &trans       &trans         &trans   &trans     &trans       &trans     &trans
              &kp LC(S)   &kp LS(LC(Z)) &kp LC(Z)   &kp S        &trans         &kp M    &trans     &trans       &trans     &trans
&trans        &trans      &kp LC(X)    &kp LC(C)    &trans       &kp LC(V)      &trans   &trans     &trans       &trans     &trans    &trans
                                       &trans       &trans       &kp SPACE      &kp LC(R) &kp ESC   &kp BSPC
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
    };
};
