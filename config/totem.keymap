//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define GAME 4
#define REAPER 5
#define SNAKE 6
#define KEBAB 7
#define CAMEL 8

// WMOD = Cmd+Ctrl+Alt held as one chord -- the macOS window-manager (AeroSpace)
// modifier. Shift is deliberately left OUT so WMOD+Shift stays a *distinct*
// combo: WMOD+n switches desktop, WMOD+Shift+n moves a window there -- the same
// super / super+shift split used on Hyprland. Cmd+Ctrl+Alt+<key> is effectively
// unused by macOS apps, unlike GUI/Cmd+number and Cmd+arrows which collide
// everywhere. Lives on the left outer pinky (base pos 20; &trans on
// NAV/SYM/ADJ so it falls through). LC/LA wrap the LGUI keycode -> Cmd+Ctrl+Alt
// all register while held. On Linux this reads as Super+Ctrl+Alt: free, and
// clear of the Ctrl+Alt+F# TTY-switch chords.
#define WMOD LC(LA(LGUI))

// Layer changes were once signalled to the desktop keymap-hud daemon in-band:
// the layer keys held F16/F17/F18 and the toggles tapped F20/F21 alongside the
// real behavior. Inert on macOS/Linux, but a host that *decodes* them turned
// every layer press into garbage (iOS/Termius renders F16 as ^P and F17 as ^Q,
// and ^Q is XON, so a stray SYM hold could freeze terminal output) -- which is
// what the PHONE override layer existed to dodge.
//
// All of that is gone. CONFIG_ZMK_BLE_LAYER_STATE (our ZMK fork) publishes the
// active/locked layer bitmasks on a GATT characteristic and the HUD reads them
// off BlueZ, so layer keys are plain &mo/&lt/&tog again and nothing leaks to
// the host. Only the HUD *toggle* still taps a key (F19, combo_hud below).
//
// Profile 4 is the phone; 0-3 are computers (see phone_sel/host_sel).
#define PHONE_PROFILE 4

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    behaviors {
        // Thumb layer-taps: tap = TAB/ESC, hold = momentary NAV/SYM. Kept as
        // explicit hold-taps rather than stock &lt so the feel stays exactly
        // where it was tuned (tap-preferred, 200ms) -- only the sentinel hold
        // that used to ride along with &mo is gone.
        lt_nav: layer_tap_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        lt_sym: layer_tap_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        // Case modes (zmk-auto-layer module): &smart_case <layer> turns a case
        // layer on and keeps it on only while "identifier" keys are typed --
        // alphas, digits, _ - and backspace/delete. Any other keycode (enter,
        // tab-tap, esc-tap, punctuation) drops back to BASE automatically, so
        // there is nothing to un-toggle. Holding NAV mid-identifier to type
        // digits is free now that layer keys emit no keycode at all, so the
        // mode survives it. On the case layers SPACE becomes the separator
        // (see the *_spc morphs); Shift+SPACE emits a real space, which also
        // ends the mode since SPACE is not in this list.
        smart_case: smart_case {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <UNDER MINUS BSPC DEL>;
            ignore-alphas;
            ignore-numbers;
            ignore-modifiers;
        };

        // caps_word tuned for SCREAMING_SNAKE: same continue rules as
        // smart_case (alphanumerics are implicit in caps-word) so it and the
        // snake layer always switch off on the same keypress.
        caps_snake: caps_snake {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <UNDER MINUS BSPC DEL>;
        };

        // SPACE replacements for the case layers. Plain tap = the separator
        // (or a sticky shift for camelCase); with Shift held it morphs into a
        // real space, which both prints the space and exits the mode.
        und_spc: und_spc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp UNDER>, <&kp SPACE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        dash_spc: dash_spc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp SPACE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        cam_spc: cam_spc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk LSHFT>, <&kp SPACE>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        // Profile-select keys that also land the board back on BASE: &to BASE
        // clears a toggled GAME/REAPER, which is what you want when handing it
        // to a different machine anyway.
        phone_sel: phone_sel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL PHONE_PROFILE>, <&to BASE>;
        };
        // Also drops the phone's link on the way out. iOS hides the on-screen
        // keyboard for as long as *any* HID keyboard is connected, and merely
        // selecting another profile doesn't disconnect the old one -- so
        // without this the phone stays keyboard-less until you disconnect by
        // hand in Settings. BT_DISC only works on an *inactive* profile (the
        // active one reconnects immediately), hence the ordering: BT_SEL first
        // demotes the phone, then BT_DISC can take it down. Default macro
        // wait-ms (100) gives the switch time to land before the disconnect.
        host_sel: host_sel {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2>,
                       <&macro_tap &bt BT_SEL MACRO_PLACEHOLDER>,
                       <&macro_tap &bt BT_DISC PHONE_PROFILE>,
                       <&macro_tap &to BASE>;
        };

        // Multi-character coding operators, fired from base-layer combos so they
        // don't need the SYM layer. Default 0ms macro timing is fine for &kp.
        pipe_arrow: pipe_arrow {   // |>  (Elixir pipe)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PIPE &kp GT>;
        };
        thin_arrow: thin_arrow {   // ->  (Elixir/Go)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
        };
        fat_arrow: fat_arrow {     // =>  (Elixir maps)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GT>;
        };
        walrus: walrus {           // :=  (Go)
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp EQUAL>;
        };

        // SCREAMING_SNAKE = caps word + the snake layer at once. Both watch
        // the same continue-list, so one exit keypress ends both together.
        scream: scream {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&caps_snake &smart_case SNAKE>;
        };

    };

    combos {
        compatible = "zmk,combos";

        // Mouse-click combos sit on adjacent top-row keys, which double as
        // gaming keys (W/E/R etc.), so they're scoped to everything *except*
        // GAME to avoid firing clicks mid-game.
        combo_lclk_l {
            timeout-ms = <20>;
            key-positions = <2 3>;
            bindings = <&mkp MB1>;
            layers = <BASE NAV SYM ADJ>;
        };

        combo_lclk_r {
            timeout-ms = <20>;
            key-positions = <6 7>;
            bindings = <&mkp MB1>;
            layers = <BASE NAV SYM ADJ>;
        };

        combo_rclk_l {
            timeout-ms = <20>;
            key-positions = <1 0>;
            bindings = <&mkp MB2>;
            layers = <BASE NAV SYM ADJ>;
        };

        combo_rclk_r {
            timeout-ms = <20>;
            key-positions = <8 9>;
            bindings = <&mkp MB2>;
            layers = <BASE NAV SYM ADJ>;
        };

        combo_mclk_l {
            bindings = <&mkp MB3>;
            key-positions = <2 1>;
            timeout-ms = <20>;
            layers = <BASE NAV SYM ADJ>;
        };

        combo_mclk_r {
            bindings = <&mkp MB3>;
            key-positions = <7 8>;
            timeout-ms = <20>;
            layers = <BASE NAV SYM ADJ>;
        };

        // Coding-operator combos, base layer only. Rare-letter key pairs keep
        // misfires near zero during normal typing.
        combo_pipe_arrow {   // K + H  ->  |>
            timeout-ms = <28>;
            key-positions = <26 27>;
            bindings = <&pipe_arrow>;
            layers = <0>;
        };
        combo_thin_arrow {   // , + .  ->  ->
            timeout-ms = <28>;
            key-positions = <28 29>;
            bindings = <&thin_arrow>;
            layers = <0>;
        };
        combo_walrus {       // C + D  ->  :=
            timeout-ms = <28>;
            key-positions = <23 24>;
            bindings = <&walrus>;
            layers = <0>;
        };
        combo_fat_arrow {    // Z + X  ->  =>
            timeout-ms = <28>;
            key-positions = <21 22>;
            bindings = <&fat_arrow>;
            layers = <0>;
        };

        // Case-mode chords. The two everyday modes sit on deliberate two-handed
        // inner-column pairs (like B+J for REAPER, so they never misfire); the
        // two rarer ones ride one-handed rare-letter pairs like the operator
        // combos above. Listed on the case layers too so you can jump straight
        // from one mode to another mid-identifier.
        combo_snake {        // V + K (bottom inner)  ->  snake_case
            timeout-ms = <40>;
            key-positions = <25 26>;
            bindings = <&smart_case SNAKE>;
            layers = <BASE SNAKE KEBAB CAMEL>;
        };
        combo_kebab {        // G + M (home inner)    ->  kebab-case
            timeout-ms = <40>;
            key-positions = <14 15>;
            bindings = <&smart_case KEBAB>;
            layers = <BASE SNAKE KEBAB CAMEL>;
        };
        combo_camel {        // X + C                 ->  camelCase
            timeout-ms = <28>;
            key-positions = <22 23>;
            bindings = <&smart_case CAMEL>;
            layers = <BASE SNAKE KEBAB CAMEL>;
        };
        combo_scream {       // H + ,                 ->  SCREAMING_SNAKE
            timeout-ms = <28>;
            key-positions = <27 28>;
            bindings = <&scream>;
            layers = <BASE SNAKE KEBAB CAMEL>;
        };

        // Both outer pinkies (bottom row, opposite halves) -> toggle keymap HUD.
        // Sends F19: an inert key on Linux and macOS that the host HUD listens
        // for (swallow it in your terminal: ghostty keybind = f19=ignore).
        // The last in-band HUD signal, now that layers ride BLE. No `layers`
        // restriction so it works from any layer; wide timeout since it's a
        // deliberate two-handed chord, not a roll.
        combo_hud {          // pos 20 + 31  ->  F19 (HUD toggle)
            timeout-ms = <50>;
            key-positions = <20 31>;
            bindings = <&kp F19>;
        };

        // Both top outer corners (Q + ;) -> toggle the GAME layer on/off.
        // A deliberate two-handed chord so it never misfires during one-handed
        // gaming, yet still reaches you to switch back off. No `layers`
        // restriction so it works from any layer, including GAME itself.
        combo_game {         // pos 0 + 9  ->  toggle GAME layer
            timeout-ms = <50>;
            key-positions = <0 9>;
            bindings = <&tog GAME>;
        };

        // Both inner top keys (B + J) -> toggle the REAPER app layer.
        // Two-handed and on rare-adjacent letters, so
        // it won't misfire while typing. No `layers` restriction, so the same
        // chord both enters REAPER and exits it.
        combo_reaper {       // pos 4 + 5  ->  toggle REAPER layer
            timeout-ms = <45>;
            key-positions = <4 5>;
            bindings = <&tog REAPER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            display-name = "BASE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     F     ┃     P     ┃     B     ┃   ┃     J     ┃     L     ┃     U     ┃     Y     ┃     ;     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     A     ┃     R     ┃     S     ┃     T     ┃     G     ┃   ┃     M     ┃     N     ┃     E     ┃     I     ┃     O     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃     Q     ┃     Z     ┃     X     ┃     C     ┃     D     ┃     V     ┃   ┃     K     ┃     H     ┃     ,     ┃     .     ┃     /     ┃     \     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃    TAB    ┃    SPC    ┃   ┃   ENTER   ┃           ┃   BSPC    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
              &kp Q       &kp W       &kp F        &kp P        &kp B        &kp J    &kp L        &kp U        &kp Y       &kp SEMI
              &mt LGUI A  &mt LALT R  &mt LCTRL S  &mt LSHFT T  &kp G        &kp M    &mt RSHFT N  &mt RCTRL E  &mt RALT I  &mt RGUI O
&kp WMOD      &kp Z       &kp X       &kp C        &kp D        &kp V        &kp K    &kp H        &kp COMMA    &kp DOT     &kp FSLH    &kp BSLH
                                      &kp DEL      &lt_nav 1 TAB  &kp SPACE  &kp RET  &lt_sym 2 ESC  &kp BSPC
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        nav_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            display-name = "NAVI";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃    ESC    ┃    CLCK   ┃     UP    ┃   SUPER   ┃     {     ┃   ┃     }     ┃     7     ┃     8     ┃     9     ┃     +     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   SHIFT   ┃   LEFT    ┃    DOWN   ┃   RIGHT   ┃     [     ┃   ┃     ]     ┃     4     ┃     5     ┃     6     ┃     -     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃    DEL    ┃    P UP   ┃   CWORD   ┃    P DN   ┃     (     ┃   ┃     )     ┃     1     ┃     2     ┃     3     ┃     *     ┃     _     ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃    TAB    ┃    SPC    ┃   ┃    ADJ    ┃     0     ┃    BSPC   ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
        &kp ESC    &sk CLCK   &kp UP      &kp LGUI   &kp LBRC    &kp RBRC  &kp N7     &kp N8     &kp N9     &kp KP_PLUS
        &kp LSHFT  &kp LEFT   &kp DOWN    &kp RIGHT  &kp LBKT    &kp RBKT  &kp N4     &kp N5     &kp N6     &kp KP_MINUS
&trans  &kp DEL    &kp PG_UP  &caps_word  &kp PG_DN  &kp LPAR    &kp RPAR  &kp N1     &kp N2     &kp N3     &kp KP_MULTIPLY  &kp UNDER
                              &trans      &trans     &trans      &mo ADJ   &kp N0     &trans
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        sim_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            display-name = "SYM";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     !     ┃     @     ┃     #     ┃     $     ┃     %     ┃   ┃     ˆ     ┃     &     ┃     *     ┃     ?     ┃     '     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     +     ┃     =     ┃     (     ┃     )     ┃     "     ┃   ┃     :     ┃     ]     ┃     [     ┃     }     ┃     {     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃     <     ┃     |     ┃     -     ┃     >     ┃     \     ┃   ┃     `     ┃     _     ┃     /     ┃     ~     ┃     ;     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃    DEL    ┃    TAB    ┃    ADJ    ┃   ┃    RET    ┃    PLAY   ┃    BSPC   ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
        &kp EXCL  &kp AT     &kp HASH   &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR   &kp QMARK  &kp SQT
        &kp PLUS  &kp EQUAL  &kp LPAR   &kp RPAR  &kp DQT      &kp COLON  &kp RBKT   &kp LBKT   &kp RBRC   &kp LBRC
&trans  &kp LT    &kp PIPE   &kp MINUS  &kp GT    &kp BSLH     &kp GRAVE  &kp UNDER  &kp SLASH  &kp TILDE  &kp SEMI  &trans
                             &trans     &trans    &mo ADJ      &trans     &kp C_PP   &trans
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        adjust_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            display-name = "ADJ";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃   RESET   ┃ BT CLEAR  ┃  OUT TOG  ┃   SEL 0   ┃   SEL 1   ┃   ┃           ┃    F7     ┃    F8     ┃    F9     ┃    F12    ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃ BOOTLOAD  ┃ BT NEXT   ┃  CLR ALL  ┃   SEL 2   ┃   SEL 3   ┃   ┃           ┃    F4     ┃    F5     ┃    F6     ┃    F11    ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃ BT PREV   ┃   SEL 4   ┃           ┃           ┃   ┃           ┃    F1     ┃    F2     ┃    F3     ┃    F10    ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃           ┃           ┃   ┃           ┃           ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
        &sys_reset   &bt BT_CLR  &out OUT_TOG    &host_sel 0   &host_sel 1     &trans  &kp F7  &kp F8  &kp F9  &kp F12
        &bootloader  &bt BT_NXT  &bt BT_CLR_ALL  &host_sel 2   &host_sel 3     &trans  &kp F4  &kp F5  &kp F6  &kp F11
&trans  &trans       &bt BT_PRV  &phone_sel      &trans        &trans          &trans  &kp F1  &kp F2  &kp F3  &kp F10  &trans
                                 &trans        &trans  &trans    &trans  &trans  &trans
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        game_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            display-name = "GAME";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            // Left half = QWERTY WASD (plain keys, no home-row mods), shifted one
            // column right to suit the stagger so the pinky gets its own column;
            // T/G/B move to that freed pinky column since the index side has no
            // room. Right half = numpad (7-8-9 / 4-5-6 / 1-2-3 in the middle
            // columns, like NAV) plus menu/chat keys and GRV for the dev console.
            // Toggle on/off with the Q + ; corner combo or the &tog key.
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     T     ┃     Q     ┃     W     ┃     E     ┃     R     ┃   ┃     `     ┃     7     ┃     8     ┃     9     ┃     -     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     G     ┃     A     ┃     S     ┃     D     ┃     F     ┃   ┃    TAB    ┃     4     ┃     5     ┃     6     ┃     .     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃    TAB    ┃     B     ┃     Z     ┃     X     ┃     C     ┃     V     ┃   ┃    ESC    ┃     1     ┃     2     ┃     3     ┃     0     ┃   GAME    ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃   CTRL    ┃   SHIFT   ┃    SPC    ┃   ┃   ENTER   ┃   BSPC    ┃    DEL    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
              &kp T       &kp Q       &kp W        &kp E        &kp R        &kp GRAVE  &kp N7     &kp N8     &kp N9      &kp MINUS
              &kp G       &kp A       &kp S        &kp D        &kp F        &kp TAB    &kp N4     &kp N5     &kp N6      &kp DOT
&kp TAB       &kp B       &kp Z       &kp X        &kp C        &kp V        &kp ESC    &kp N1     &kp N2     &kp N3      &kp N0     &tog GAME
                                      &kp LCTRL    &kp LSHFT    &kp SPACE    &kp RET    &kp BSPC   &kp DEL
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        reaper_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            display-name = "REAPR";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            // A starter REAPER layer. Reach/leave it with the B+J combo
            // (combo_reaper). The left hand carries OS-standard edit chords that
            // Reaper honours no matter your config (Save/Undo/Redo/Cut/Copy/
            // Paste); the right hand + thumbs carry Reaper transport/edit
            // actions. The latter use Reaper *defaults* — verify or rebind them
            // in Reaper's Actions list (Actions > Show action list) to taste.
            // Everything else is &trans (falls through to BASE). Tune freely.
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃           ┃           ┃           ┃           ┃           ┃   ┃           ┃           ┃           ┃           ┃           ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   SAVE    ┃   REDO    ┃   UNDO    ┃   SPLIT   ┃           ┃   ┃   MARK    ┃           ┃           ┃           ┃           ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃    CUT    ┃   COPY    ┃           ┃   PASTE   ┃   ┃           ┃           ┃           ┃           ┃           ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃           ┃   PLAY    ┃   ┃    REC    ┃    ESC    ┃   BSPC    ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
              &trans      &trans       &trans       &trans       &trans         &trans   &trans     &trans       &trans     &trans
              &kp LC(S)   &kp LS(LC(Z)) &kp LC(Z)   &kp S        &trans         &kp M    &trans     &trans       &trans     &trans
&trans        &trans      &kp LC(X)    &kp LC(C)    &trans       &kp LC(V)      &trans   &trans     &trans       &trans     &trans    &trans
                                       &trans       &trans       &kp SPACE      &kp LC(R) &kp ESC   &kp BSPC
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        // Case-mode layers: identical to BASE except SPACE, which becomes the
        // word separator (or a sticky shift for camelCase). Entered via the
        // smart_case combos; they exit on their own -- see the smart_case
        // behavior note. HRMs still work since every key falls through.

        snake_layer {
            display-name = "SNAKE";
            bindings = <
              &trans      &trans      &trans       &trans       &trans       &trans   &trans       &trans       &trans      &trans
              &trans      &trans      &trans       &trans       &trans       &trans   &trans       &trans       &trans      &trans
&trans        &trans      &trans      &trans       &trans       &trans       &trans   &trans       &trans       &trans      &trans      &trans
                                      &trans       &trans       &und_spc     &trans   &trans       &trans
            >;
        };

        kebab_layer {
            display-name = "KEBAB";
            bindings = <
              &trans      &trans      &trans       &trans       &trans       &trans   &trans       &trans       &trans      &trans
              &trans      &trans      &trans       &trans       &trans       &trans   &trans       &trans       &trans      &trans
&trans        &trans      &trans      &trans       &trans       &trans       &trans   &trans       &trans       &trans      &trans      &trans
                                      &trans       &trans       &dash_spc    &trans   &trans       &trans
            >;
        };

        camel_layer {
            display-name = "CAMEL";
            bindings = <
              &trans      &trans      &trans       &trans       &trans       &trans   &trans       &trans       &trans      &trans
              &trans      &trans      &trans       &trans       &trans       &trans   &trans       &trans       &trans      &trans
&trans        &trans      &trans      &trans       &trans       &trans       &trans   &trans       &trans       &trans      &trans      &trans
                                      &trans       &trans       &cam_spc     &trans   &trans       &trans
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
    };
};
